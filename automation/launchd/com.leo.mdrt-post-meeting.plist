<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/leo</string>
		<key>PATH</key>
		<string>/Users/leo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>com.leo.mdrt-post-meeting</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/leo/.local/bin/mdrt-post-meeting.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/leo/.local/log/mdrt-meeting.log</string>
	<key>StandardOutPath</key>
	<string>/Users/leo/.local/log/mdrt-meeting.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>18</integer>
		<key>Minute</key>
		<integer>30</integer>
		<key>Weekday</key>
		<integer>2</integer>
	</dict>
</dict>
</plist>
